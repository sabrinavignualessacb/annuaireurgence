rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Filet de sécurité global (refus par défaut)
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Fonctions utilitaires globales
    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isBootstrappedAdmin() {
      return isVerified() && request.auth.token.email == 'service.qse.33450@gmail.com';
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidSharedUids(listVal) {
      return listVal is list
        && listVal.size() <= 10
        && (listVal.size() == 0 || (listVal[0] is string && listVal[0].size() <= 128));
    }

    function isValidZoneIdList(listVal) {
      return listVal is list
        && listVal.size() <= 50
        && (listVal.size() == 0 || (listVal[0] is string && listVal[0].size() <= 128));
    }

    // Contrôle relationnel sur le site parent (pour get/create/update/delete uniquement, jamais dans list)
    function siteDoc(siteId) {
      return get(/databases/$(database)/documents/sites/$(siteId)).data;
    }

    function siteDocAfter(siteId) {
      return getAfter(/databases/$(database)/documents/sites/$(siteId)).data;
    }

    function memberPath(siteId, uid) {
      return /databases/$(database)/documents/sites/$(siteId)/members/$(uid);
    }

    function teamPinPath(siteId) {
      return /databases/$(database)/documents/sites/$(siteId)/private/teamPin;
    }

    function isValidTeamPinEntry(siteId, code) {
      return code is string
        && code.size() >= 4
        && code.size() <= 32
        && exists(teamPinPath(siteId))
        && get(teamPinPath(siteId)).data.pin == code;
    }

    function isSiteOwner(siteId) {
      return isVerified()
        && exists(/databases/$(database)/documents/sites/$(siteId))
        && siteDoc(siteId).ownerUid == request.auth.uid;
    }

    function isSiteOwnerAfter(siteId) {
      return isVerified()
        && existsAfter(/databases/$(database)/documents/sites/$(siteId))
        && siteDocAfter(siteId).ownerUid == request.auth.uid;
    }

    function isSiteMember(siteId) {
      return isSignedIn() && exists(memberPath(siteId, request.auth.uid));
    }

    function isMemberEditorValid(siteId) {
      return isSiteMember(siteId)
        && get(memberPath(siteId, request.auth.uid)).data.role == 'editor'
        && (
          isValidTeamPinEntry(siteId, get(memberPath(siteId, request.auth.uid)).data.inviteCode)
          || (
            isVerified()
            && exists(/databases/$(database)/documents/siteInvites/$(get(memberPath(siteId, request.auth.uid)).data.inviteCode))
            && get(/databases/$(database)/documents/siteInvites/$(get(memberPath(siteId, request.auth.uid)).data.inviteCode)).data.active == true
            && get(/databases/$(database)/documents/siteInvites/$(get(memberPath(siteId, request.auth.uid)).data.inviteCode)).data.siteId == siteId
            && get(/databases/$(database)/documents/siteInvites/$(get(memberPath(siteId, request.auth.uid)).data.inviteCode)).data.role == 'editor'
          )
        );
    }

    function isSiteEditor(siteId) {
      return isBootstrappedAdmin()
        || isSiteOwner(siteId)
        || isMemberEditorValid(siteId);
    }

    function isSiteEditorAfter(siteId) {
      return isBootstrappedAdmin()
        || isSiteOwnerAfter(siteId)
        || isMemberEditorValid(siteId);
    }

    function isSiteReader(siteId) {
      return isBootstrappedAdmin()
        || isSiteOwner(siteId)
        || isSiteMember(siteId)
        || (
          isSignedIn()
          && exists(/databases/$(database)/documents/sites/$(siteId))
          && 'teamShared' in siteDoc(siteId)
          && siteDoc(siteId).teamShared == true
        );
    }

    // 3. Schémas de validation (Anti-Update-Gap)
    function isValidSiteConfig(data) {
      return data.keys().hasAll([
          'name',
          'ownerUid',
          'sharedUids',
          'companyName',
          'companyLogoDataUrl',
          'lastUpdatedDate',
          'autoUpdateDate',
          'headerHeightPx',
          'zoneScale',
          'emergencyBoxShape',
          'activeZoneId',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'name',
          'ownerUid',
          'sharedUids',
          'teamShared',
          'companyName',
          'companyLogoDataUrl',
          'companyLogoSizePx',
          'sstLogoDataUrl',
          'epiLogoDataUrl',
          'evacuationLogoDataUrl',
          'serreFileLogoDataUrl',
          'guideLogoDataUrl',
          'pictogramSizePx',
          'roleBadgeSizePx',
          'lastUpdatedDate',
          'autoUpdateDate',
          'headerHeightPx',
          'zoneScale',
          'emergencyBoxShape',
          'activeZoneId',
          'createdAt',
          'updatedAt'
        ])
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 120
        && data.ownerUid is string && data.ownerUid.size() >= 1 && data.ownerUid.size() <= 128
        && isValidSharedUids(data.sharedUids)
        && (!('teamShared' in data) || data.teamShared is bool)
        && data.companyName is string && data.companyName.size() <= 120
        && data.companyLogoDataUrl is string && data.companyLogoDataUrl.size() <= 400000
        && (!('companyLogoSizePx' in data) || (data.companyLogoSizePx is number && data.companyLogoSizePx >= 24 && data.companyLogoSizePx <= 96))
        && (!('sstLogoDataUrl' in data) || (data.sstLogoDataUrl is string && data.sstLogoDataUrl.size() <= 100000))
        && (!('epiLogoDataUrl' in data) || (data.epiLogoDataUrl is string && data.epiLogoDataUrl.size() <= 100000))
        && (!('evacuationLogoDataUrl' in data) || (data.evacuationLogoDataUrl is string && data.evacuationLogoDataUrl.size() <= 100000))
        && (!('serreFileLogoDataUrl' in data) || (data.serreFileLogoDataUrl is string && data.serreFileLogoDataUrl.size() <= 100000))
        && (!('guideLogoDataUrl' in data) || (data.guideLogoDataUrl is string && data.guideLogoDataUrl.size() <= 100000))
        && (!('pictogramSizePx' in data) || (data.pictogramSizePx is number && data.pictogramSizePx >= 28 && data.pictogramSizePx <= 68))
        && (!('roleBadgeSizePx' in data) || (data.roleBadgeSizePx is number && data.roleBadgeSizePx >= 18 && data.roleBadgeSizePx <= 48))
        && data.lastUpdatedDate is string && data.lastUpdatedDate.size() <= 20
        && data.autoUpdateDate is bool
        && data.headerHeightPx is number && data.headerHeightPx >= 48 && data.headerHeightPx <= 140
        && data.zoneScale is number && data.zoneScale >= 0.95 && data.zoneScale <= 1.6
        && data.emergencyBoxShape is string && data.emergencyBoxShape in ['pills', 'stacked', 'rounded', 'chamfer']
        && data.activeZoneId is string && data.activeZoneId.size() <= 128
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidZone(data) {
      return data.keys().hasAll([
          'name',
          'nearbyZoneIds',
          'ownerUid',
          'sharedUids',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'name',
          'nearbyZoneIds',
          'epiSitePersonIds',
          'ownerUid',
          'sharedUids',
          'teamShared',
          'createdAt',
          'updatedAt'
        ])
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 120
        && isValidZoneIdList(data.nearbyZoneIds)
        && (!('epiSitePersonIds' in data) || isValidZoneIdList(data.epiSitePersonIds))
        && data.ownerUid is string && data.ownerUid.size() >= 1 && data.ownerUid.size() <= 128
        && isValidSharedUids(data.sharedUids)
        && (!('teamShared' in data) || data.teamShared is bool)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidPerson(data) {
      return data.keys().hasAll([
          'lastName',
          'firstName',
          'internalNumber',
          'roles',
          'primaryZoneId',
          'nearbyZoneIds',
          'trainingExpiryDate',
          'isActive',
          'ownerUid',
          'sharedUids',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'lastName',
          'firstName',
          'internalNumber',
          'roles',
          'primaryZoneId',
          'coveredZoneIds',
          'nearbyZoneIds',
          'trainingExpiryDate',
          'isActive',
          'ownerUid',
          'sharedUids',
          'teamShared',
          'createdAt',
          'updatedAt'
        ])
        && data.lastName is string && data.lastName.size() >= 1 && data.lastName.size() <= 80
        && data.firstName is string && data.firstName.size() >= 1 && data.firstName.size() <= 80
        && data.internalNumber is string && data.internalNumber.size() >= 4 && data.internalNumber.size() <= 9
        && data.internalNumber.matches('^\\d{4}(/\\d{4})?$')
        && data.roles is list && data.roles.size() >= 1 && data.roles.size() <= 4
        && data.roles.hasOnly(['SST', 'EPI', 'GUIDE', 'SERRE_FILE'])
        && data.primaryZoneId is string && data.primaryZoneId.size() >= 1 && data.primaryZoneId.size() <= 128
        && (!('coveredZoneIds' in data) || isValidZoneIdList(data.coveredZoneIds))
        && isValidZoneIdList(data.nearbyZoneIds)
        && data.trainingExpiryDate is string && data.trainingExpiryDate.size() <= 10
        && (data.trainingExpiryDate == '' || data.trainingExpiryDate.matches('^\\d{4}-\\d{2}-\\d{2}$'))
        && data.isActive is bool
        && data.ownerUid is string && data.ownerUid.size() >= 1 && data.ownerUid.size() <= 128
        && isValidSharedUids(data.sharedUids)
        && (!('teamShared' in data) || data.teamShared is bool)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidSiteMember(data) {
      return data.keys().hasAll(['uid', 'siteOwnerUid', 'displayName', 'role', 'inviteCode', 'joinedAt'])
        && data.keys().hasOnly(['uid', 'siteOwnerUid', 'displayName', 'role', 'inviteCode', 'joinedAt'])
        && data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128
        && data.siteOwnerUid is string && data.siteOwnerUid.size() >= 1 && data.siteOwnerUid.size() <= 128
        && data.displayName is string && data.displayName.size() <= 120
        && data.role is string && data.role in ['editor', 'viewer']
        && data.inviteCode is string && data.inviteCode.size() >= 4 && data.inviteCode.size() <= 64
        && data.joinedAt is timestamp;
    }

    function isValidSiteInvite(data) {
      return data.keys().hasAll(['siteId', 'createdByUid', 'role', 'active', 'createdAt'])
        && data.keys().hasOnly(['siteId', 'createdByUid', 'role', 'active', 'createdAt'])
        && isValidId(data.siteId)
        && data.createdByUid is string && data.createdByUid.size() >= 1 && data.createdByUid.size() <= 128
        && data.role is string && data.role in ['editor', 'viewer']
        && data.active is bool
        && data.createdAt is timestamp;
    }

    function isValidTeamPin(data) {
      return data.keys().hasAll(['pin', 'updatedAt'])
        && data.keys().hasOnly(['pin', 'updatedAt'])
        && data.pin is string && data.pin.size() >= 4 && data.pin.size() <= 32
        && data.updatedAt is timestamp;
    }

    // 4. Règles des collections
    match /sites/{siteId} {
      allow get: if isValidId(siteId) && isSiteReader(siteId);
      allow list: if isSignedIn() && (
        isBootstrappedAdmin()
        || existing().ownerUid == request.auth.uid
        || request.auth.uid in existing().sharedUids
        || ('teamShared' in existing() && existing().teamShared == true)
      );
      allow create: if isVerified()
        && isValidId(siteId)
        && isValidSiteConfig(incoming())
        && (incoming().ownerUid == request.auth.uid || isBootstrappedAdmin())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isSignedIn()
        && isValidId(siteId)
        && isValidSiteConfig(incoming())
        && isSiteEditor(siteId)
        && incoming().ownerUid == existing().ownerUid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          // Action 1 : Mise à jour des paramètres / logos / zone active
          incoming().diff(existing()).affectedKeys().hasOnly([
            'name',
            'companyName',
            'companyLogoDataUrl',
            'companyLogoSizePx',
            'sstLogoDataUrl',
            'epiLogoDataUrl',
            'evacuationLogoDataUrl',
            'serreFileLogoDataUrl',
            'guideLogoDataUrl',
            'pictogramSizePx',
            'roleBadgeSizePx',
            'lastUpdatedDate',
            'autoUpdateDate',
            'headerHeightPx',
            'zoneScale',
            'emergencyBoxShape',
            'activeZoneId',
            'updatedAt'
          ])
          // Action 2 : Gestion des accès partagés (propriétaire ou admin uniquement)
          || ((existing().ownerUid == request.auth.uid || isBootstrappedAdmin())
              && incoming().diff(existing()).affectedKeys().hasOnly(['sharedUids', 'teamShared', 'updatedAt']))
        );
      allow delete: if isVerified()
        && isValidId(siteId)
        && (existing().ownerUid == request.auth.uid || isBootstrappedAdmin());

      // Sous-collection Zones
      match /zones/{zoneId} {
        allow get: if isValidId(siteId) && isValidId(zoneId) && isSiteReader(siteId);
        allow list: if isSignedIn() && (
          isBootstrappedAdmin()
          || existing().ownerUid == request.auth.uid
          || request.auth.uid in existing().sharedUids
          || ('teamShared' in existing() && existing().teamShared == true)
        );
        allow create: if isSignedIn()
          && isValidId(siteId)
          && isValidId(zoneId)
          && isValidZone(incoming())
          && existsAfter(/databases/$(database)/documents/sites/$(siteId))
          && isSiteEditorAfter(siteId)
          && incoming().ownerUid == siteDocAfter(siteId).ownerUid
          && (!('teamShared' in incoming()) || ('teamShared' in siteDocAfter(siteId) && incoming().teamShared == siteDocAfter(siteId).teamShared))
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;
        allow update: if isSignedIn()
          && isValidId(siteId)
          && isValidId(zoneId)
          && isValidZone(incoming())
          && isSiteEditor(siteId)
          && incoming().ownerUid == existing().ownerUid
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && (
            incoming().diff(existing()).affectedKeys().hasOnly(['name', 'nearbyZoneIds', 'epiSitePersonIds', 'updatedAt'])
            || ((siteDoc(siteId).ownerUid == request.auth.uid || isBootstrappedAdmin())
                && incoming().diff(existing()).affectedKeys().hasOnly(['sharedUids', 'teamShared', 'updatedAt']))
          );
        allow delete: if isSignedIn()
          && isValidId(siteId)
          && isValidId(zoneId)
          && isSiteEditor(siteId);
      }

      // Sous-collection Personnel
      match /people/{personId} {
        allow get: if isValidId(siteId) && isValidId(personId) && isSiteReader(siteId);
        allow list: if isSignedIn() && (
          isBootstrappedAdmin()
          || existing().ownerUid == request.auth.uid
          || request.auth.uid in existing().sharedUids
          || ('teamShared' in existing() && existing().teamShared == true)
        );
        allow create: if isSignedIn()
          && isValidId(siteId)
          && isValidId(personId)
          && isValidPerson(incoming())
          && existsAfter(/databases/$(database)/documents/sites/$(siteId))
          && isSiteEditorAfter(siteId)
          && incoming().ownerUid == siteDocAfter(siteId).ownerUid
          && (!('teamShared' in incoming()) || ('teamShared' in siteDocAfter(siteId) && incoming().teamShared == siteDocAfter(siteId).teamShared))
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;
        allow update: if isSignedIn()
          && isValidId(siteId)
          && isValidId(personId)
          && isValidPerson(incoming())
          && isSiteEditor(siteId)
          && incoming().ownerUid == existing().ownerUid
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && (
            incoming().diff(existing()).affectedKeys().hasOnly([
              'lastName',
              'firstName',
              'internalNumber',
              'roles',
              'primaryZoneId',
              'coveredZoneIds',
              'nearbyZoneIds',
              'trainingExpiryDate',
              'isActive',
              'updatedAt'
            ])
            || ((siteDoc(siteId).ownerUid == request.auth.uid || isBootstrappedAdmin())
                && incoming().diff(existing()).affectedKeys().hasOnly(['sharedUids', 'teamShared', 'updatedAt']))
          );
        allow delete: if isSignedIn()
          && isValidId(siteId)
          && isValidId(personId)
          && isSiteEditor(siteId);
      }

      // Sous-collection Paramètres privés (Code PIN d'équipe)
      match /private/{docId} {
        allow get: if isValidId(siteId)
          && isValidId(docId)
          && (isSiteOwner(siteId) || isBootstrappedAdmin());
        allow list: if false;
        allow create: if isValidId(siteId)
          && docId == 'teamPin'
          && isValidTeamPin(incoming())
          && (isSiteOwner(siteId) || isBootstrappedAdmin())
          && incoming().updatedAt == request.time;
        allow update: if isValidId(siteId)
          && docId == 'teamPin'
          && isValidTeamPin(incoming())
          && (isSiteOwner(siteId) || isBootstrappedAdmin())
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['pin', 'updatedAt']);
        allow delete: if isValidId(siteId)
          && isValidId(docId)
          && (isSiteOwner(siteId) || isBootstrappedAdmin());
      }

      // Sous-collection Membres du site
      match /members/{memberUid} {
        allow get: if isValidId(siteId)
          && isValidId(memberUid)
          && isSignedIn()
          && (memberUid == request.auth.uid || isSiteOwner(siteId) || isBootstrappedAdmin());
        allow list: if isVerified() && (
          isBootstrappedAdmin()
          || existing().siteOwnerUid == request.auth.uid
        );
        allow create: if isSignedIn()
          && isValidId(siteId)
          && isValidId(memberUid)
          && isValidSiteMember(incoming())
          && memberUid == request.auth.uid
          && incoming().uid == request.auth.uid
          && incoming().joinedAt == request.time
          && exists(/databases/$(database)/documents/sites/$(siteId))
          && incoming().siteOwnerUid == siteDoc(siteId).ownerUid
          && (
            (
              incoming().role == 'editor'
              && isValidTeamPinEntry(siteId, incoming().inviteCode)
            )
            || (
              isVerified()
              && exists(/databases/$(database)/documents/siteInvites/$(incoming().inviteCode))
              && get(/databases/$(database)/documents/siteInvites/$(incoming().inviteCode)).data.active == true
              && get(/databases/$(database)/documents/siteInvites/$(incoming().inviteCode)).data.siteId == siteId
              && get(/databases/$(database)/documents/siteInvites/$(incoming().inviteCode)).data.role == incoming().role
            )
          );
        allow update: if isSignedIn()
          && isValidId(siteId)
          && isValidId(memberUid)
          && isValidSiteMember(incoming())
          && incoming().uid == existing().uid
          && incoming().siteOwnerUid == existing().siteOwnerUid
          && incoming().joinedAt == existing().joinedAt
          && (
            (
              (isSiteOwner(siteId) || isBootstrappedAdmin())
              && incoming().inviteCode == existing().inviteCode
              && incoming().diff(existing()).affectedKeys().hasOnly(['role', 'displayName'])
            )
            || (
              memberUid == request.auth.uid
              && incoming().role == 'editor'
              && isValidTeamPinEntry(siteId, incoming().inviteCode)
              && incoming().diff(existing()).affectedKeys().hasOnly(['inviteCode', 'displayName', 'role'])
            )
          );
        allow delete: if isSignedIn()
          && isValidId(siteId)
          && isValidId(memberUid)
          && (memberUid == request.auth.uid || isSiteOwner(siteId) || isBootstrappedAdmin());
      }
    }

    // Codes d'invitation pour rejoindre un site partagé
    match /siteInvites/{inviteCode} {
      allow get: if isValidId(inviteCode) && isVerified();
      allow list: if isVerified() && (
        isBootstrappedAdmin()
        || existing().createdByUid == request.auth.uid
      );
      allow create: if isVerified()
        && isValidId(inviteCode)
        && isValidSiteInvite(incoming())
        && incoming().createdByUid == request.auth.uid
        && incoming().createdAt == request.time
        && exists(/databases/$(database)/documents/sites/$(incoming().siteId))
        && (isSiteOwner(incoming().siteId) || isBootstrappedAdmin());
      allow update: if isVerified()
        && isValidId(inviteCode)
        && isValidSiteInvite(incoming())
        && (existing().createdByUid == request.auth.uid || isBootstrappedAdmin())
        && incoming().siteId == existing().siteId
        && incoming().createdByUid == existing().createdByUid
        && incoming().createdAt == existing().createdAt
        && incoming().diff(existing()).affectedKeys().hasOnly(['active', 'role']);
      allow delete: if isVerified()
        && isValidId(inviteCode)
        && (existing().createdByUid == request.auth.uid || isBootstrappedAdmin());
    }
  }
}
